section definitions
  include Devices.ic10

  ; Volatile data
  alias   devRefId        r0
  alias   devNameHash     r1
  alias   scratch         r2
  alias   scratch2        r3
  alias   table_end       r4
  alias   scratch3        r5
  alias   findPrefab      r6
  alias   networkIdx      r7
  alias   networkCount    r8
  alias   devTableIdx     r9
  alias   devPrefab       r10
  alias   scratch4        r11

  define  ChillerLoop     Hash("Chiller Loop")

  define  SP_DIODES       10
  define  SP_REFERENCEIDS 11 ; Start of RefIds

section application requires definitions

  poke 0 LogicType.RatioMethane
  poke 1 LogicType.RatioLiquidMethane
  poke 2 LogicType.RatioOxygen
  poke 3 LogicType.RatioLiquidOxygen
  poke 4 LogicType.RatioNitrogen
  poke 5 LogicType.RatioLiquidNitrogen
  poke 6 LogicType.RatioCarbonDioxide
  poke 7 LogicType.RatioLiquidCarbonDioxide
  poke 8 LogicType.RatioOzone
  poke 9 LogicType.RatioLiquidOzone

  ; Init for prefab finding
  move sp SP_REFERENCEIDS
  move devTableIdx SP_DIODES

  ; Find regulators, purge valves, and volume pumps
  move findPrefab DiodeSlide2
  jal prefab_search

mainloop:
  yield

  get sp db SP_DIODES
  move scratch4 0


diode_loop:
  pop devRefId
  l devNameHash devRefId NameHash

  get scratch3 db scratch4
  add scratch4 scratch4 1
  lbn scratch2 PipeAnalyzer ChillerLoop scratch3 Sum

  get scratch3 db scratch4
  add scratch4 scratch4 1
  lbn scratch3 PipeAnalyzer ChillerLoop scratch3 Sum

  add scratch2 scratch2 scratch3
  s devRefId Setting scratch2

  bgt sp SP_REFERENCEIDS diode_loop
  j mainloop


prefab_search:
  move networkIdx -1
  lb networkCount findPrefab PrefabHash Sum

_prefab_search_loop:
  add networkIdx networkIdx 1
  get devRefId db:0 networkIdx
  l devPrefab devRefId PrefabHash
  bne devPrefab findPrefab _prefab_search_loop
  push devRefId
  sub networkCount networkCount findPrefab
  bnez networkCount _prefab_search_loop
  poke devTableIdx sp
  add devTableIdx devTableIdx 1
  j ra
