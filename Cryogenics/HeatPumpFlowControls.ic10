section definitions
  include HPC_Stack.ic10
  include Devices.ic10

  define  SP_REGULATORS   0
  define  SP_PURGEVALVES  1
  define  SP_VOLUMEPUMPS  2
  define  SP_GANALYZERS   3
  define  SP_LANALYZERS   4
  define  SP_PCDS1        5
  define  SP_PCDS2        6
  define  SP_REFERENCEIDS 7 ; Start of RefIds


  ; Volatile data
  alias   devRefId        r0
  alias   devNameHash     r1
  alias   scratch         r2
  alias   scratch2        r3
  alias   table_end       r4
  alias   scratch3        r5
  alias   findPrefab      r6
  alias   networkIdx      r7
  alias   networkCount    r8
  alias   devTableIdx     r9
  alias   devPrefab       r10
  alias   scratch4        r11

  ; Init for prefab finding
  move sp SP_REFERENCEIDS
  move devTableIdx SP_REGULATORS

  ; Find regulators, purge valves, and volume pumps
  move findPrefab PresRegulator
  jal prefab_search
  move findPrefab PurgeValve
  jal prefab_search
  move findPrefab VolumePump
  jal prefab_search

  ; Find pipe analyzers
  move findPrefab PipeAnalyzer
  jal prefab_search
  move findPrefab LPipeAnalyzer
  jal prefab_search

  ; Find PCDs
  move findPrefab PhaseCondensor
  jal prefab_search
  move findPrefab PhaseEvaporator
  jal prefab_search

main_loop:
  yield

  get sp db SP_PCDS2
  get table_end db SP_VOLUMEPUMPS

analyzer_loop:
  pop devRefId
  l devNameHash devRefId NameHash
  l scratch devRefId Temperature
  sbn EdgewiseMeter devNameHash Setting scratch
  sbn LogicMemory devNameHash Setting scratch
  l scratch devRefId Pressure
  mul scratch scratch 1000
  sbn LEDDisplay3 devNameHash Setting scratch
  sbn LEDDisplay3 devNameHash Mode 14
  sbn LEDDisplay2 devNameHash Setting scratch
  sbn LEDDisplay2 devNameHash Mode 14
  bdnvl devRefId VolumeOfLiquid no_liq_read
  l scratch devRefId VolumeOfLiquid
  sbn Gauge devNameHash Setting scratch
no_liq_read:
  bgt sp table_end analyzer_loop

pump_loop:
  pop devRefId
  l devNameHash devRefId NameHash
  lbn scratch FlipSwitch devNameHash Setting Sum
  s devRefId On scratch
  lbn scratch2 Dial devNameHash Setting Sum
  s devRefId Setting scratch2

  get scratch3 db SP_PURGEVALVES
  sge scratch3 sp scratch3

  select scratch4 scratch3 1 1000
  mul scratch2 scratch2 scratch4

  select scratch2 scratch scratch2 Str("Off")
  sbn LEDDisplay2 devNameHash Setting scratch2

  select scratch2 scratch Color.White Color.Orange
  sbn LEDDisplay2 devNameHash Color scratch2


  select scratch2 scratch3 12 14
  select scratch2 scratch scratch2 10
  sbn LEDDisplay2 devNameHash Mode scratch2

  bgt sp SP_REFERENCEIDS pump_loop
  j main_loop

prefab_search:
  move networkIdx -1
  lb networkCount findPrefab PrefabHash Sum

_prefab_search_loop:
  add networkIdx networkIdx 1
  get devRefId db:0 networkIdx
  l devPrefab devRefId PrefabHash
  bne devPrefab findPrefab _prefab_search_loop
  push devRefId
  sub networkCount networkCount findPrefab
  bnez networkCount _prefab_search_loop
  poke devTableIdx sp
  add devTableIdx devTableIdx 1
  j ra

